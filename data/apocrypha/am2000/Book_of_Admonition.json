  "chapters": [
    {
      "chapter": 1,
      "verses": {
        "1": "የይሁዳ ንጉሥ የሕዝቅያስ ወዳጆች ያለ ጥርጥር የጻፉት የተለያየ የሰሎሞን ተግሣጽ ነው።",
        "2": "የእግዚአብሔር ክብር ነገርን ይሰውራል፥",
        "3": "ሰማይ ከፍ ያለ ነው፥ ምድርም ጥልቅ ነው፥",
        "4": "ያልጠራውን ብር አጥራው፥",
        "5": "ከንጉሡ ፊት ክፉዎችን አጥፋ፥",
        "6": "በንጉሥ ፊት አትታበይ፥",
        "7": "በመኰንን ፊት ከምቷረድ፦",
